[
    {
        "Effect": "Allow",
        "Action": [
            "s3:GetObject",
            "s3:ListBucket",
            "s3:PutObject",
            "s3:GetBucketLocation",
            "s3:DeleteObject",
            "s3:GetObjectVersion",
            "s3:GetLifecycleConfiguration"
        ],
        "Resource" : [
            "${bucket_s3_arn}",
            "${bucket_s3_arn}/*"
        ]
    }
]